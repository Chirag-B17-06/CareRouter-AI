# CareRouter AI configuration. Copy to backend/.env and fill in on the host.
# Everything below is a PLACEHOLDER - never commit real values (.env is git-ignored).

# --- Core ------------------------------------------------------------------------------
APP_ENV=development                       # production | development | test
DATABASE_URL=sqlite:///./care_router.db
# Required (>= 32 chars) when APP_ENV=production. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# IANA timezone used for appointment slots and reminders
HOSPITAL_TIMEZONE=Asia/Kolkata

# --- First administrator (only used when the users table is empty) -------------------------
# Prefer `python manage.py create-user <name> admin`, which prompts for the password.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Abuse protection ----------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120                 # per client address, 0 disables (use a gateway for multi-instance)
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# --- Speech-to-text --------------------------------------------------------------------------
ASR_MAX_UPLOAD_MB=25
ASR_MAX_DURATION_SECONDS=600
ASR_WORKERS=1                             # parallel transcription jobs in this process
ASR_PROVIDER_ORDER=indic_conformer,whisper
WHISPER_MODEL_SIZE=medium                 # tiny | base | small | medium | large-v3
# AI4Bharat IndicConformer (optional; see docs/ASR_SETUP.md)
INDIC_ASR_ENABLED=false
INDIC_ASR_MODEL_ID=ai4bharat/indic-conformer-600m-multilingual
INDIC_ASR_DECODING=ctc                    # ctc | rnnt
INDIC_ASR_MODEL_REVISION=                 # pin a reviewed commit hash in production (model runs remote code)
HF_TOKEN=                                 # Hugging Face token of an account that accepted the model terms
# 0 = audio is deleted right after transcription. >0 allows users to opt in to retaining recordings.
AUDIO_RETENTION_HOURS=0

# --- Structured extraction ---------------------------------------------------------------------
EXTRACTION_PROVIDER=rules                 # rules (offline, default) | llm
# The LLM adapter sends transcript text to an external service. Leave false unless that transfer is
# authorised and covered by a data-processing agreement.
EXTERNAL_LLM_ALLOWED=false
LLM_API_BASE=https://api.anthropic.com
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# --- Appointments --------------------------------------------------------------------------------
APPOINTMENT_AUTO_CONFIRM=true             # false: bookings stay 'pending' until staff confirm
REMINDER_HOURS_BEFORE=24
